# microCMSの接続情報
# このファイルをコピーして「.env.local」という名前にし、= の右側に値を入れてください。
# .env.local はGitに含まれないので、APIキーが外に出ることはありません。

# サービスID（管理画面URL https://○○○.microcms.io の ○○○ の部分）
MICROCMS_SERVICE_DOMAIN=

# APIキー（管理画面の「権限管理」→「APIキー」で確認できます）
MICROCMS_API_KEY=

# APIのエンドポイント名（別の名前で作った場合だけ変更）
MICROCMS_NEWS_ENDPOINT=news
